{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Achievement Shelf",
  "version": "0.1.0",
  "identifier": "dev.achievementshelf.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Achievement Shelf",
        "width": 520,
        "height": 250,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "alwaysOnBottom": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNkExMjlEMzIwODk4MjEKUldRaG1BZ3luUkpxSHRiVEtQRThONGtnU0d2Z0V1dWo4NDRPWEl4WG16NzV3STVhb2w0VVkwUnMK",
      "endpoints": [
        "https://github.com/connorknoetze/achievement-shelf/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
